# RIS 参数组 ris3 —— 中 RIS: DV 为基准的 1/10, DI 与基准同量级 (DSiI 1.1e7 -> 1.2e7)。
#
# 只写与 JOB.sh 设置区不同的项。算法/种群/搜索框/成分靶值/时限等全部沿用 JOB.sh,
# 三套必须保持一致, 否则结果之间不可比。
#
# 提交:      bash calibration/ctl/JOB.sh ris3
# 看进度:    bash calibration/ctl/matfdm.sh status
# 导前十名:  bash calibration/ctl/matfdm.sh export 'ris3_ft*'
# 长时验证:  bash calibration/ctl/VERIFY.sh --pattern 'ris3_ft*'

PREFIX=ris3_ft

# DV/DI 走 overrides 下发。J_all_via_medium 只用 D(1)..D(4) 标量索引,
# 所以 json 数组解成列向量也不影响结果。
# 注意: DV/DI 不在 run_calibration_case 的参数指纹里 —— 改了这里必须先
#   bash calibration/ctl/matfdm.sh clean <运行名>
# 否则旧腿会被当成有效结果沿用。
OVERRIDES='{"eff": 0.2, "DV": [1.9e6, 1.5e6, 1.2e6, 1.7e6], "DI": [4e6, 4e6, 4e6, 1.2e7]}'

# 编译产物钉死在提交时这一版: 另外两套重编时 CURRENT 会改指向,
# 而每条腿是执行时才解析路径 —— 不钉死就会中途换二进制。
BUILD_DIR=/pscratch/sd/w/wzhuo001/matfdm_build/89ea201
